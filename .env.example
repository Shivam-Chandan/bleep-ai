# ---- Ollama / Model backend ----
# URL where your local model is served (via the authed tunnel or direct).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional bearer token sent to the Ollama backend (for an authed tunnel).
# Leave unset if Ollama is reached directly on localhost.
# OLLAMA_AUTH_TOKEN=

# ---- Public app URL (auto-synced by scripts/sync-tunnel-url.sh) ----
# Public HTTPS URL where this Next.js app is reachable (the Cloudflare
# quick tunnel to port 3000). Overrides the Vercel fallback in scripts.
APP_BASE_URL=https://your-app-tunnel-url.trycloudflare.com

# ---- OpenRouter (free cloud models) ----
# Free server-side models. Get a (free) key at https://openrouter.ai/keys.
# When unset, the model picker only lists your local Ollama models.
# OPENROUTER_API_KEY=

# Optional: advertise your app/site to OpenRouter (required for some providers).
# OPENROUTER_BASE_URL=
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=Bleep AI

# ---- Session auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# ---- Database ----
# Preferred: a remote Turso/libSQL database. Required for serverless hosts
# (e.g. Vercel), which have a read-only filesystem with no persistent disk.
# Get these from https://turso.tech (create a DB, then a token).
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Fallback (local dev only): path to a local SQLite file. Used only when
# TURSO_DATABASE_URL is unset. Defaults to ./data/app.db.
# DB_PATH=/absolute/path/to/app.db

# ---- Registration ----
# Set to "false" to disable self-signup after you've created accounts.
REGISTRATION_OPEN=true