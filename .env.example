# ---- Ollama / Model backend ----
# URL where your local model is served (via the authed tunnel or direct).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Context window (tokens) requested from Ollama via num_ctx. The app trims
# history to fit whatever you set here. MUST match DIGEST_CONTEXT_WINDOW (and
# hence warm-ollama.sh) — a mismatch makes Ollama reload the model on every
# request, which costs ~15-19s on this box. 8192 fits in the 2GB GPU at
# num_gpu=24 (1.58GB at 4096 vs 1.67GB at 8192).
# OLLAMA_CONTEXT_WINDOW=8192

# Hard cap on the length of a local answer (tokens). A CPU-only model can take
# 20+ minutes to emit a long reply, so local responses are bounded here.
# OLLAMA_MAX_TOKENS=512

# Optional bearer token sent to the Ollama backend (for an authed tunnel).
# Leave unset if Ollama is reached directly on localhost.
# OLLAMA_AUTH_TOKEN=

# CPU threads the local model may use for inference. Defaults to the physical
# core count (2 on this box). Setting it below the auto-detected 4 logical
# threads keeps the system responsive during long generations.
# OLLAMA_NUM_THREAD=2

# ---- Public app URL (auto-synced by scripts/sync-tunnel-url.sh) ----
# Public HTTPS URL where this Next.js app is reachable (the permanent Tailscale
# Funnel to port 11435). Overrides the Vercel fallback in scripts.
APP_BASE_URL=https://bleep-ai.tailc327c1.ts.net

# ---- OpenRouter (free cloud models) ----
# Free server-side models. Get a (free) key at https://openrouter.ai/keys.
# When unset, the model picker only lists your local Ollama models.
# OPENROUTER_API_KEY=

# Optional: advertise your app/site to OpenRouter (required for some providers).
# OPENROUTER_BASE_URL=
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=Bleep AI

# Assumed context window for the cloud model(s), in tokens. The free router
# auto-selects a model per request, so this is the floor all free models meet.
# OPENROUTER_CONTEXT_WINDOW=32768

# ---- Web search agent (free, no API key) ----
# The assistant can call a web_search tool (DuckDuckGo HTML endpoint) to ground
# answers in current information, then cite sources. No key or account needed.
# Max results injected per search (1-10, default 5).
# SEARCH_MAX_RESULTS=5

# ---- Session auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# ---- Data-at-rest encryption ----
# 32-byte key used to encrypt everything sensitive before it is stored in the
# database: chat titles, message bodies, digest payloads (emails/calendar/slack/
# zoom), daily summaries, ingest-token labels, usernames, and rate-limit keys.
# A stolen database file or Turso dump is therefore unreadable ciphertext.
#
# Generate with: openssl rand -base64 32
# REQUIRED in production. When unset, a key is derived from SESSION_SECRET so
# existing deployments keep working (dev convenience only).
#
# The SAME key must be set for the Next app (Vercel) AND the box-side
# digest-worker, or the two cannot read each other's rows. Never change it once
# data is stored: doing so makes all encrypted data permanently unreadable.
# ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ---- Database ----
# Local-first: the DB lives on this box, served by `sqld` (libSQL over HTTP),
# bound to the Tailscale IP only (100.90.40.69:8080). Services on the same
# box/tailnet use that URL directly. Vercel (serverless, no local disk) reaches
# it through Tailscale Funnel at the public HTTPS URL below.
#
# Token is a JWT minted from <sqld-dir>/sqld.priv.pem.
#
# Direct (box-side services: digest worker): 
# DATABASE_URL=http://100.90.40.69:8080
# Via public funnel (Vercel app) — note the trailing slash, the libsql client
# resolves /v2/pipeline against it:
# DATABASE_URL=https://bleep-ai.tailc327c1.ts.net/sql/
# DATABASE_AUTH_TOKEN=

# Fallback (local dev only): path to a local SQLite file. Used only when
# DATABASE_URL is unset. Defaults to ./data/app.db.
# DB_PATH=/absolute/path/to/app.db

# ---- Registration ----
# Set to "false" to disable self-signup after you've created accounts.
REGISTRATION_OPEN=true

# ---- Public infra endpoints (/api/warm, /api/health) ----
# When set, these endpoints require this secret in a Bearer token (or the
# header below). Leave unset to keep them open for local dev / uptime checks.
# Generate with: openssl rand -base64 24
# HEALTH_CHECK_SECRET=
# Optional: custom header name for the infra secret (default: x-health-check).
# HEALTH_SECRET_HEADER=

# ---- Rate limiting ----
# Failed-login and signup attempts are limited per IP/username and stored in
# the app database. Tune via (start values):
# LOGIN_MAX_ATTEMPTS=10
# SIGNUP_MAX_PER_IP=3

# ---- Daily digest (Gmail / Calendar / Slack) ----
# Timezone used to bucket ingested items into a calendar day and to name
# summaries (IANA name, e.g. America/New_York). Defaults to the host timezone.
# DIGEST_TZ=America/New_York

# Secret that protects POST /api/digest/summarize. Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET`. Leave unset to keep
# the endpoint open in local dev. Generate with: openssl rand -base64 24
# CRON_SECRET=

# Context window (tokens) requested from the model for digest generation via
# num_ctx. Must be large enough for the richer multi-source prompt; defaults to
# 8192. Raise only if the model + host support it.
# DIGEST_CONTEXT_WINDOW=8192