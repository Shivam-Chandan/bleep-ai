# Ollama Configuration
# For LOCAL testing: use localhost
# For VERCEL deployment: use your Cloudflare Tunnel URL
OLLAMA_BASE_URL=http://localhost:11434

# Default model (must be pulled in Ollama first)
OLLAMA_MODEL=gemma4:26b

# ============================================================
# CLOUDFLARE TUNNEL SETUP (for Vercel deployment)
# ============================================================
# 1. Start Ollama with open origins (required for tunnel access):
#    OLLAMA_HOST=0.0.0.0:11434 OLLAMA_ORIGINS="*" ollama serve
#
# 2. Start the tunnel:
#    cloudflared tunnel --url http://localhost:11434
#
# 3. Set OLLAMA_BASE_URL to the generated https://xxx.trycloudflare.com URL
#    in your Vercel environment variables.
# ============================================================