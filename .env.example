# ---- Ollama / Model backend ----
# URL where your local model is served (via the authed tunnel or direct).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional bearer token sent to the Ollama backend (for an authed tunnel).
# Leave unset if Ollama is reached directly on localhost.
# OLLAMA_AUTH_TOKEN=

# ---- Session auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# ---- Database ----
# Path to the SQLite file. Defaults to ./data/app.db if unset.
# DB_PATH=/absolute/path/to/app.db

# ---- Registration ----
# Set to "false" to disable self-signup after you've created accounts.
REGISTRATION_OPEN=true